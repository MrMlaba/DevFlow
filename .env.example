# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored - never commit real credentials.

# ---------------------------------------------------------------------------
# Supabase (Phase 1) - https://app.supabase.com/project/_/settings/api
# ---------------------------------------------------------------------------

# Safe to expose to the browser: paired with row-level security (see
# database/migrations/), the anon key can only do what RLS policies allow.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# NEVER expose this to the browser or commit it. Bypasses row-level
# security entirely - used only in trusted server code (see
# src/lib/supabase/admin.ts) such as the database seed script and
# server-side member-invite lookups.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------

# Base URL used to build email confirmation / password reset redirect links.
# Set to your deployed URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# GitHub integration (Phase 4)
# https://github.com/settings/developers -> New OAuth App
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:3000/api/github/oauth/callback
# ---------------------------------------------------------------------------

GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Local development only
# ---------------------------------------------------------------------------

# Password assigned to the demo accounts created by `npm run db:seed`
# (see database/seed/README.md). Pick anything - it's local-only and never
# used outside your own machine.
SEED_USER_PASSWORD=

# ---------------------------------------------------------------------------
# Not used yet - added when the phase that needs them lands (see
# docs/devops-roadmap.md). Listed here so the full shape of DevFlow's
# configuration is visible in one place as the project grows.
# ---------------------------------------------------------------------------

# Redis - not added in Phase 6 after all: nothing in the app does caching
# or background job processing yet, so there's nothing for it to back.
# Added in whichever future phase introduces a real consumer (see
# docs/devops-roadmap.md, Phase 6).
# REDIS_URL=

# Phase 11 - AWS
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Phase 18 - AI Assistant
# OPENAI_API_KEY=
